<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Excel Generator Library Demo</title>
  <link rel="icon" type="image/x-icon" href="images/Favicon.svg">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="banner">
    <img src="images/Excel Banner.svg" alt="Site Banner" class="banner-image" style="display:none;">
  </header>
  <div class="layout">
    <nav class="sidebar">
      <ul>
        <li class="nav-item active" id="nav-home">
          <img src="images/Home Icon.svg" alt="Home Icon">
          <span>Home</span>
        </li>
        <li class="nav-item" id="nav-calendar">
          <img src="images/Calendar Icon.svg" alt="Calendar Icon">
          <span>Calendar Builder</span>
        </li>
        <li class="nav-item" id="nav-roundrobin">
          <img src="images/Bracket Icon.svg" alt="Round Robin Icon">
          <span>Round Robin Scheduler</span>
        </li>
      </ul>
    </nav>
    <main class="main-content" id="mainContent">
      <!-- Dynamic content will be injected here by navigation.js -->
    </main>
  </div>
  <script src="../dist/bundle.js"></script>
  <script>
    // Wait for bundle to load and DOM to be ready
    window.addEventListener('DOMContentLoaded', function() {
      if (window.setupNavigationAndHandlers) {
        window.setupNavigationAndHandlers();
      }
    });
  </script>
</body>
</html>
